# Used by docker compose (copy to .env). All optional.
POSTGRES_PASSWORD=change-me

# Only for running the Go server outside Docker (`cd gamevote-api-go && go run ./cmd/api`):
# DATABASE_URL=postgres://gamevote:change-me@localhost:5432/gamevote?sslmode=disable
# PORT=8080
# STATIC_DIR=web          # built Vue app; leave unset in dev, vite serves it
# LOG_LEVEL=info          # debug | info | warn | error
# LOG_FORMAT=text         # text | json
